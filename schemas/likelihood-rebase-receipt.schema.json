{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ATMAN-LATTICE/schemas/likelihood-rebase-receipt.schema.json",
  "title": "ATMAN-LATTICE LikelihoodRebaseReceipt v1.10",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_hash", "old_model_hash", "new_model_hash", "prior_hypothesis_hash", "posterior_hypothesis_hash", "old_model_generation", "new_model_generation", "rebased_at", "rebase_hash"],
  "properties": {
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "old_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "new_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prior_hypothesis_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "posterior_hypothesis_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "old_model_generation": {"type": "integer", "minimum": 0},
    "new_model_generation": {"type": "integer", "minimum": 1},
    "rebased_at": {"type": "integer", "minimum": 0},
    "rebase_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}