{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ATMAN-LATTICE/schemas/authorization-ledger.schema.json",
  "title": "ATMAN-LATTICE AuthorizationLedger v0.7",
  "type": "object",
  "additionalProperties": false,
  "required": ["generation", "head_event_hash", "events"],
  "properties": {
    "generation": {"type": "integer", "minimum": 0},
    "head_event_hash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "events": {
      "type": "array",
      "items": {"$ref": "authorization-event.schema.json"}
    }
  }
}
