{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atman-lattice.local/schemas/verification-cost-estimator.schema.json",
  "title": "Verification Cost Estimator Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["estimator_key", "sample_count", "total_observed_cost_units", "mean_cost_units", "observation_hashes", "snapshot_hash"],
  "properties": {
    "estimator_key": {"type": "string", "minLength": 1},
    "sample_count": {"type": "integer", "minimum": 0},
    "total_observed_cost_units": {"type": "integer", "minimum": 0},
    "mean_cost_units": {"type": "integer", "minimum": 0},
    "observation_hashes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "snapshot_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
