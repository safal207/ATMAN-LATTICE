{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ATMAN-LATTICE/schemas/heldout-structural-validation.schema.json",
  "title": "HeldOutStructuralValidationReceipt",
  "type": "object",
  "required": ["candidate_hash", "proposal_hash", "selection_replay_hash", "policy_hash", "history_hash", "split_hash", "selection_sample_hashes", "evaluation_sample_hashes", "case_hashes", "evaluated_case_count", "min_evaluation_samples", "base_edge_count", "proposed_edge_count", "edge_penalty_ppm", "status", "proposer_ref", "validator_ref", "validated_at", "validation_hash"],
  "properties": {
    "candidate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_replay_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "history_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_sample_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "evaluation_sample_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "case_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
    "evaluated_case_count": {"type": "integer", "minimum": 0},
    "min_evaluation_samples": {"type": "integer", "minimum": 1},
    "base_mean_brier_ppm": {"type": ["integer", "null"], "minimum": 0},
    "proposed_mean_brier_ppm": {"type": ["integer", "null"], "minimum": 0},
    "raw_improvement_ppm": {"type": ["integer", "null"]},
    "base_edge_count": {"type": "integer", "minimum": 0},
    "proposed_edge_count": {"type": "integer", "minimum": 0},
    "edge_penalty_ppm": {"type": "integer", "minimum": 0},
    "base_regularized_brier_ppm": {"type": ["integer", "null"], "minimum": 0},
    "proposed_regularized_brier_ppm": {"type": ["integer", "null"], "minimum": 0},
    "regularized_improvement_ppm": {"type": ["integer", "null"]},
    "status": {"enum": ["INSUFFICIENT_HELDOUT", "HELDOUT_IMPROVED", "OVERFIT_SIGNAL", "COMPLEXITY_REJECTED"]},
    "proposer_ref": {"type": "string", "minLength": 1},
    "validator_ref": {"type": "string", "minLength": 1},
    "validated_at": {"type": "integer", "minimum": 0},
    "validation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}