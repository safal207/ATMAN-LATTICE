{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ATMAN-LATTICE/schemas/structural-graph-review.schema.json",
  "title": "StructuralGraphReviewReceipt",
  "type": "object",
  "required": ["proposal_hash", "replay_hash", "decision", "rationale_ref", "proposer_ref", "reviewer_ref", "reviewed_at", "review_hash"],
  "properties": {
    "proposal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "replay_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {"enum": ["APPROVE", "HOLD", "REJECT"]},
    "rationale_ref": {"type": "string", "minLength": 1},
    "proposer_ref": {"type": "string", "minLength": 1},
    "reviewer_ref": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "integer", "minimum": 0},
    "review_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
