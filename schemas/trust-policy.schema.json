{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ATMAN-LATTICE/schemas/trust-policy.schema.json",
  "title": "ATMAN-LATTICE TrustPolicy v1.2",
  "type": "object",
  "required": ["generation", "threshold", "roots", "previous_policy_hash", "activated_at", "policy_hash"],
  "properties": {
    "generation": {"type": "integer", "minimum": 0},
    "threshold": {"type": "integer", "minimum": 1},
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "public_key"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "previous_policy_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "activated_at": {"type": "integer", "minimum": 0},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
