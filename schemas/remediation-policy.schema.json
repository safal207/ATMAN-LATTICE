{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ATMAN-LATTICE/schemas/remediation-policy.schema.json",
  "title": "RemediationPolicy",
  "type": "object",
  "required": ["policy_ref","subject_identity_ref","allowed_actions","rollback_requires_nonpositive_improvement","registered_at","policy_hash"],
  "properties": {
    "policy_ref": {"type":"string","minLength":1},
    "subject_identity_ref": {"type":"string","minLength":1},
    "allowed_actions": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["HOLD","COLLECT_MORE_DATA","PARAMETER_REVISION","STRUCTURAL_REVISION","SAFE_ROLLBACK"]}},
    "rollback_requires_nonpositive_improvement": {"const":true},
    "registered_at": {"type":"integer","minimum":0},
    "policy_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}