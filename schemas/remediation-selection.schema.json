{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/safal207/ATMAN-LATTICE/schemas/remediation-selection.schema.json","title":"RemediationSelectionReceipt","type":"object",
  "required":["selection_ref","snapshot_hash","proposal_hashes","assessment_hashes","selected_proposal_hash","selected_assessment_hash","selected_action","selected_status","selected_proposer_ref","selected_assessor_ref","selector_ref","selected_at","selection_hash"],
  "properties":{
    "selection_ref":{"type":"string","minLength":1},"snapshot_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "proposal_hashes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"assessment_hashes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
    "selected_proposal_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"selected_assessment_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"selected_action":{"enum":["HOLD","COLLECT_MORE_DATA","PARAMETER_REVISION","STRUCTURAL_REVISION","SAFE_ROLLBACK"]},"selected_status":{"enum":["NON_MUTATING_SAFE","DOWNSTREAM_GOVERNANCE_REQUIRED","ROLLBACK_SUPPORTED"]},
    "selected_proposer_ref":{"type":"string","minLength":1},"selected_assessor_ref":{"type":"string","minLength":1},"selector_ref":{"type":"string","minLength":1},"selected_at":{"type":"integer","minimum":0},"selection_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },"additionalProperties":false
}