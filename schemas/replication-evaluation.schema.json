{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ATMAN-LATTICE/schemas/replication-evaluation.schema.json",
  "title": "ReplicationEvaluationReceipt",
  "type": "object",
  "required": ["target_hash","batch_hash","batch_generation","mode","source_ref","environment_ref","policy_hash","confirmed_revision_hash","candidate_hash","confirmed_graph_hash","case_hashes","evaluated_case_count","min_replication_samples","temporal_gap","base_mean_brier_ppm","confirmed_mean_brier_ppm","base_regularized_brier_ppm","confirmed_regularized_brier_ppm","regularized_improvement_ppm","baseline_confirmed_mean_brier_ppm","proposed_brier_degradation_ppm","allowed_brier_degradation_ppm","required_min_regularized_improvement_ppm","drift_kind","status","batch_keeper_ref","evaluator_ref","evaluated_at","evaluation_hash"],
  "properties": {
    "target_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "batch_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "batch_generation": {"type":"integer","minimum":0},
    "mode": {"enum":["TEMPORAL","EXTERNAL","TEMPORAL_EXTERNAL"]},
    "source_ref": {"type":"string","minLength":1},
    "environment_ref": {"type":"string","minLength":1},
    "policy_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "confirmed_revision_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "candidate_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "confirmed_graph_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "case_hashes": {"type":"array","items":{"type":"string","pattern":"^[0-9a-f]{64}$"},"uniqueItems":true},
    "evaluated_case_count": {"type":"integer","minimum":0},
    "min_replication_samples": {"type":"integer","minimum":1},
    "temporal_gap": {"type":"integer","minimum":0},
    "base_mean_brier_ppm": {"type":["integer","null"]},
    "confirmed_mean_brier_ppm": {"type":["integer","null"]},
    "base_regularized_brier_ppm": {"type":["integer","null"]},
    "confirmed_regularized_brier_ppm": {"type":["integer","null"]},
    "regularized_improvement_ppm": {"type":["integer","null"]},
    "baseline_confirmed_mean_brier_ppm": {"type":"integer","minimum":0,"maximum":1000000},
    "proposed_brier_degradation_ppm": {"type":["integer","null"]},
    "allowed_brier_degradation_ppm": {"type":"integer","minimum":0},
    "required_min_regularized_improvement_ppm": {"type":"integer","minimum":0},
    "drift_kind": {"enum":["NONE","STRUCTURAL","PERFORMANCE","BOTH"]},
    "status": {"enum":["INSUFFICIENT_REPLICATION","REPLICATED","DRIFT_SIGNAL"]},
    "batch_keeper_ref": {"type":"string","minLength":1},
    "evaluator_ref": {"type":"string","minLength":1},
    "evaluated_at": {"type":"integer","minimum":0},
    "evaluation_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}